1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/platform/sbasic.ico"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x00040004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Structured BASIC contributors"
            VALUE "FileDescription", "Structured BASIC interpreter"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "sbasic"
            VALUE "LegalCopyright", "Copyright 2026 the Structured BASIC contributors"
            VALUE "OriginalFilename", "sbasic.exe"
            VALUE "ProductName", "Structured BASIC"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
