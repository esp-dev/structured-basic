FUNCTION REPEAT$(TEXT$, N)
    LOCAL RESULT$
    IF N = 0 THEN
        RETURN ""
    END IF
    RESULT$ = TEXT$ + REPEAT$(TEXT$, N - 1)
    RETURN RESULT$
END FUNCTION
DIM WORDS$(3)
WORDS$(0) = "alpha"
WORDS$(1) = UCASE$(WORDS$(0))
WORDS$(2) = REPEAT$("!", 3)
FOR I = 0 TO 2
    PRINT WORDS$(I)
NEXT I
DIM RATIO AS SINGLE
RATIO = VAL("1.25")
SELECT CASE CINT(RATIO)
CASE 0
    PRINT "zero"
CASE 1, 2
    PRINT STR$(RATIO); " "; MID$(WORDS$(0), 2, 3)
CASE ELSE
    PRINT "other"
END SELECT
